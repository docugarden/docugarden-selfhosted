# DocuGarden Self-Hosted Environment
# Copy this file to .env or run ./setup-wizard.sh to generate it.

# ── Public URL ────────────────────────────────────────
PUBLIC_URL=http://localhost
TZ=Etc/UTC
FRONTEND_PORT=80

# ── Docker Images ─────────────────────────────────────
# DocuGarden images are always pulled from Docker Hub.
IMAGE_TAG=latest

# ── CORS ──────────────────────────────────────────────
# Origin allowed to call the backend. Defaults to empty (same-origin).
CORS_ORIGIN=http://localhost
