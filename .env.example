# DocuGarden Self-Hosted Environment
# Copy this file to .env or run ./setup-wizard.sh to generate it.

# ── Public URL ────────────────────────────────────────
# Public domain or IP where DocuGarden is reachable. HTTPS is used automatically.
DOMAIN=localhost
PUBLIC_URL=https://localhost

# Optional local IP address for LAN access. When set, Caddy serves a self-signed
# certificate for this IP (browsers will show a warning you can proceed through).
# The public DOMAIN above will still use a real Let's Encrypt certificate.
INTERNAL_IP=

TZ=Etc/UTC

# ── Docker Images ─────────────────────────────────────
# DocuGarden images are always pulled from Docker Hub.
IMAGE_TAG=latest

# ── CORS ──────────────────────────────────────────────
# Origin allowed to call the backend. Defaults to empty (same-origin).
CORS_ORIGIN=https://localhost
