# Docugarden Self-Hosted Environment
# Copy this file to .env or run ./setup-wizard.sh to generate it.

# ── Public URL ────────────────────────────────────────
# Public domain or IP where Docugarden is reachable. HTTPS is used automatically.
DOMAIN=localhost
PUBLIC_URL=https://localhost

# Optional local IP address for LAN access. When set, Caddy serves a self-signed
# certificate for this IP (browsers will show a warning you can proceed through).
# The public DOMAIN above will still use a real Let's Encrypt certificate.
INTERNAL_IP=

TZ=Etc/UTC

# ── Docker Images ─────────────────────────────────────
# Docugarden images are always pulled from Docker Hub.
IMAGE_TAG=latest

# ── CORS ──────────────────────────────────────────────
# Comma-separated origins allowed to call the backend. Include the LAN URL when
# INTERNAL_IP is set, for example: https://example.com,https://192.168.1.10
CORS_ORIGIN=https://localhost

# System mail defaults. Configuration saved in the admin UI takes precedence.
SYSTEM_MAIL_PROVIDER=disabled
SYSTEM_MAIL_FROM_ADDRESS=
SYSTEM_MAIL_FROM_NAME=Docugarden
SYSTEM_MAIL_SMTP_HOST=
SYSTEM_MAIL_SMTP_PORT=587
SYSTEM_MAIL_SMTP_TLS=starttls
SYSTEM_MAIL_SMTP_USERNAME=
# Optional credential files inside the backend container; never put secrets here.
SYSTEM_MAIL_SMTP_PASSWORD_FILE=
SYSTEM_MAIL_GRAPH_TENANT_ID=
SYSTEM_MAIL_GRAPH_CLIENT_ID=
SYSTEM_MAIL_GRAPH_CLIENT_SECRET_FILE=
